n(res[0].boxes) > 0:\n","            for box in res[0].boxes:\n","                conf = float(box.conf[0])\n","                cls_id = int(box.cls[0])\n","                class_name = model.names[cls_id]\n","\n","                if class_name == 'closed eyes':\n","                    closed_scores.append(conf)\n","                elif class_name == 'opened eyes':\n","                    open_scores.append(conf)\n","\n","        # frame-level closure probability\n","        if closed_scores and open_scores:\n","            p_t = max(closed_scores) / (max(closed_scores) + max(open_scores))\n","        elif closed_scores:\n","            p_t = max(closed_scores)\n","        elif open_scores:\n","            p_t = 1.0 - max(open_scores)\n","        else:\n","            p_t = 0.0\n","\n","        p_tilde.append(p_t)\n","\n","    p_tilde = np.array(p_tilde, dtype=float)\n","    print(f\"Probabilities p(t): {p_tilde}\")\n","\n","    # --- Applying your Equations ---\n","\n","    # Identify the segment [si, ei] where p(t) >= theta (Eq 4.3)\n","    blinks = []\n","    in_blink = False\n","    si = -1 # Initialize si to an invalid value\n","\n","    # Iterate through p_tilde to find blink segments\n","    for t in range(1, len(p_tilde)): # Start from 1 to compare p_tilde[t-1] and p_tilde[t]\n","        # Start of blink: crosses threshold from below\n","        if not in_blink and p_tilde[t-1] < theta and p_tilde[t] >= theta:\n","            si = t\n","            in_blink = True\n","\n","        # End of blink: crosses threshold from above\n","        elif in_blink and p_tilde[t-1] >= theta and p_tilde[t] < theta:\n","            ei = t\n","            blinks.append((si, ei))\n","            in_blink = False\n","            si = -1 # Reset si for the next blink detection\n","    maxi = 0\n","    # Handle case where a blink started but the sequence ended before it officially closed\n","    if in_blink and si != -1:\n","        blinks.append((si, len(p_tilde) - 1)) # Assume it ends at the last frame\n","\n","\n","    if not blinks:\n","        print(\"No blink detected: p(t) never crossed threshold theta.\")\n","        return # Exit if no blinks\n","\n","    # Now, iterate through the detected blinks and calculate features\n","    for blink_idx, (si, ei) in enumerate(blinks):\n","        # Ensure valid segment before calculations\n","        if si >= ei:\n","            print(f\"Warning: Invalid blink segment detected: [{si}, {ei}]. Skipping.\")\n","            continue\n","\n","        # Duration (Eq 4.9)\n","        duration = ei - si + 1\n","        if duration > maxi :\n","          maxi = duration\n","        # Peak frame bi (from section 4.3.1)\n","        # bi is the index within the segment with max closure\n","        # np.argmax needs a non-empty array. Handle edge case if segment is tiny.\n","        if p_tilde[si:ei+1].size == 0:\n","            bi = si # Fallback to start of segment if slice is empty\n","        else:\n","            bi = si + np.argmax(p_tilde[si:ei+1])\n","\n","        # Amplitude (Eq 4.10)\n","        # Amplitude = p(bi) - min(p(si), p(ei))\n","        baseline = min(p_tilde[si], p_tilde[ei])\n","        amplitude = p_tilde[bi] - baseline\n","\n","        # Reopening Velocity (Eq 4.11)\n","        # ReopeningVelocity = (p(bi) - p(ei)) / (ei - bi)\n","        if ei > bi:\n","            velocity = (p_tilde[bi] - p_tilde[ei]) / (ei - bi)\n","        else:\n","            velocity = 0.0 # Cannot calculate if peak is at the very end or no reopening phase\n","\n","        # Frequency (Eq 4.12)\n","        # Using the literal interpretation of the user's provided formula: 100 * (i / ei)\n","        # where 'i' is implicitly 1 for the current blink and 'ei' is the end frame index.\n","        frequency = 100 * (1 / (ei + 1))\n","\n","        print(f\"\\n--- Extracted Features for Blink {blink_idx + 1} ---\")\n","        print(f\"Interval B_i: [{si}, {ei}]\")\n","        print(f\"Duration: {duration} frames\")